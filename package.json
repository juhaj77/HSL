{
  "name": "hsl-bussikartta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reaaliaikainen HSL-bussikartta valitulle linjalle (Leaflet + OpenStreetMap + Digitransit GraphQL + GTFS-RT).",
  "scripts": {
    "dev": "concurrently -k -n VITE,API -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "gtfs-realtime-bindings": "^1.1.1",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}